<Project Sdk="Microsoft.NET.Sdk">

  <!-- Оболочка представления (ТЗ §2.1): WinForms/WPF Modern Shell, визуальный дизайнер
       бланков, контроллеры диалогов и мастеров. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Picket302.App</RootNamespace>
    <AssemblyName>Picket302.App</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>Оболочка Picket302: главное окно оператора (WinForms).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picket302.Application\Picket302.Application.csproj" />
    <!-- Общий состав слоя данных: тот же набор репозиториев и прикладных
         служб, что и в серверной службе совместного режима. -->
    <ProjectReference Include="..\Picket302.Composition\Picket302.Composition.csproj" />
    <ProjectReference Include="..\Picket302.ComAutomation\Picket302.ComAutomation.csproj" />
    <ProjectReference Include="..\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\Picket302.Infrastructure\Picket302.Infrastructure.csproj" />
    <ProjectReference Include="..\Picket302.Printing\Picket302.Printing.csproj" />
    <!-- Контракт совместного режима: типы сообщений протокола. -->
    <ProjectReference Include="..\Picket302.Shared\Picket302.Shared.csproj" />
  </ItemGroup>

  <!-- Шаблон письма по умолчанию и стили редактора писем поставляются файлами
       рядом с программой (ТЗ §8.7, функция 97: «Шаблон письма по умолчанию и
       стили … хранятся файлами рядом с программой и редактируются»). -->
  <ItemGroup>
    <None Update="UI\Editors\emailedit\*.html" CopyToOutputDirectory="PreserveNewest" Link="emailedit\%(Filename)%(Extension)" />
    <None Update="UI\Editors\emailedit\*.css" CopyToOutputDirectory="PreserveNewest" Link="emailedit\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- COM-сервер автоматизации поставляется рядом с оболочкой: при регистрации
       в ветку LocalServer32 записывается путь к исполняемому файлу сервера,
       а не оболочки (ТЗ §8.9, функция 114; §9.1 «ProgID PEPro.Application»).
       Общие библиотеки (Application, Domain, Infrastructure, Printing) в каталог
       сборки оболочки уже попадают через ссылки на проекты.

       Каталог сборки COM-сервера обязан совпадать по идентификатору среды
       выполнения с каталогом сборки оболочки. Раньше идентификатор среды в
       пути не участвовал, и рядом с оболочкой оказывалась сборка сервера для
       другой среды (framework-dependent вместо self-contained): её
       runtimeconfig.json требовал установленного .NET Desktop Runtime, и на
       рабочей машине без него COM-сервер не запускался. -->
  <Target Name="CopyComAutomationServer" AfterTargets="Build">
    <PropertyGroup>
      <ComAutomationOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)..\Picket302.ComAutomation\bin\$(Platform)\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\</ComAutomationOutputDir>
      <ComAutomationOutputDir Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildThisFileDirectory)..\Picket302.ComAutomation\bin\$(Platform)\$(Configuration)\net8.0-windows\</ComAutomationOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <ComAutomationPayload Include="$(ComAutomationOutputDir)Picket302.ComAutomation.exe" />
      <ComAutomationPayload Include="$(ComAutomationOutputDir)Picket302.ComAutomation.deps.json" />
      <ComAutomationPayload Include="$(ComAutomationOutputDir)Picket302.ComAutomation.runtimeconfig.json" />
      <ComAutomationPayload Include="$(ComAutomationOutputDir)PrintEnvelopePro.tlb" />
    </ItemGroup>
    <Copy SourceFiles="@(ComAutomationPayload)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ComAutomationPayload)' != '' And Exists('%(ComAutomationPayload.FullPath)')" />
  </Target>

  <!-- Проверка состава опубликованной сборки. Обязательный состав рядом с
       Picket302.App.exe: COM-сервер автоматизации с собственной конфигурацией
       запуска, библиотека типов, шаблон письма и нативная библиотека SQLite.
       Публикация завершается ошибкой, если обязательного файла нет: молча
       неполный пакет доходит до владельца и ломается уже на машине оператора. -->
  <Target Name="ValidatePublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <PublishRequiredFile Include="$(PublishDir)Picket302.App.exe" />
      <PublishRequiredFile Include="$(PublishDir)Picket302.App.dll" />
      <PublishRequiredFile Include="$(PublishDir)Picket302.ComAutomation.exe" />
      <PublishRequiredFile Include="$(PublishDir)Picket302.ComAutomation.dll" />
      <PublishRequiredFile Include="$(PublishDir)Picket302.ComAutomation.runtimeconfig.json" />
      <PublishRequiredFile Include="$(PublishDir)Picket302.ComAutomation.deps.json" />
      <PublishRequiredFile Include="$(PublishDir)PrintEnvelopePro.tlb" />
      <PublishRequiredFile Include="$(PublishDir)emailedit\default.html" />
      <!-- Нативная библиотека SQLite: в самодостаточной публикации она лежит
           в корне каталога, в зависимой от .NET — в runtimes\<среда>\native. -->
      <PublishRequiredFile Include="$(PublishDir)e_sqlite3.dll" Condition="Exists('$(PublishDir)e_sqlite3.dll')" />
      <PublishRequiredFile Include="$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll" Condition="!Exists('$(PublishDir)e_sqlite3.dll') And Exists('$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll')" />
    </ItemGroup>
    <ItemGroup>
      <PublishMissingFile Include="@(PublishRequiredFile)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Error Condition="'@(PublishMissingFile)' != ''"
           Text="Публикация неполна: обязательные файлы не найдены рядом с Picket302.App.exe: @(PublishMissingFile->'%(Identity)', ', '). Пакет установки собирать нельзя." />
  </Target>

</Project>
