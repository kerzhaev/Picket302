<Project Sdk="Microsoft.NET.Sdk">

  <!-- Слой инфраструктуры и данных (ТЗ §2.1): репозитории (SQLite/PostgreSQL),
       файловый процессор бланков (.lbk/ZIP), экспорт OpenXML/XSLT, адаптеры периферии,
       защищённое хранилище секретов.
       Допустимые зависимости: доменный слой и слой печати. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Picket302.Infrastructure</RootNamespace>
    <AssemblyName>Picket302.Infrastructure</AssemblyName>
    <Description>Слой инфраструктуры и данных Picket302: СУБД, файлы, сеть.</Description>
    <!-- Экспорт в Excel без Office (ТЗ §8.5, функции 61 и 69) обращается к
         представлению грида DataGridView: тип требуется лишь для чтения
         данных, вызовов OLE/COM Excel в слое нет. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <!-- Контроль шрифта ZIPcode (GDI32, §6.3): перечисление установленных шрифтов. -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- Структурированный журнал с независимыми каналами (приложение, печать,
       аудит, почта) и ротацией по размеру и дню (§10.3, §8.11, функция 111). -->
  <ItemGroup Label="Журналирование">
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- Миграция с баз данных предшественника (ТЗ §8.9, функции 117 и 118):
       драйвер MySQL и ODBC-провайдер для файлов .mdb. -->
  <ItemGroup Label="Миграция с исходных баз">
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="System.Data.Odbc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\Picket302.Printing\Picket302.Printing.csproj" />
  </ItemGroup>

  <!-- Миграции схемы поставляются как встроенные ресурсы сборки (ТЗ §3.1.19,
       §10.2). Имя файла: V<версия>__<описание>.sql. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\**\*.sql" />
  </ItemGroup>

  <!-- Определения запросов слоя данных хранятся файлами query.xml, а не в
       коде (ТЗ §4.1); для текущей поставки обязательна команда диалекта
       Sqlite, PostgreSQL-вариант хранится для совместимости. -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\Queries\*.xml" />
  </ItemGroup>

  <!-- Поставляемые XSLT-стили документов (ТЗ §8.4, функция 67): 16 стилей
       для конвейера WordprocessingML (функция 68), исполняются штатным
       XslCompiledTransform без MS Office. -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\Documents\*.xslt" />
  </ItemGroup>

  <!-- Словари суммы прописью (.lng) — расширяемый набор файлов локализации
       (ТЗ §8.11, функции 150–151). -->
  <ItemGroup>
    <EmbeddedResource Include="Text\lng\*.lng" />
  </ItemGroup>

  <!-- Файлы локализации поставляются рядом с программой (ТЗ §8.11, функция 112:
       «Файлы lang/<код>.xml и lng/<валюта>.lng»). Интерфейсные строки лежат
       в каталоге lang, словари суммы прописью — в каталоге lng; оба набора
       копируются в каталог вывода, поэтому переключение языка и добавление
       нового языка копированием шаблона работают без правки кода. -->
  <ItemGroup>
    <None Update="Localization\lang\*.xml" CopyToOutputDirectory="PreserveNewest" Link="lang\%(Filename)%(Extension)" />
    <None Update="Text\lng\*.lng" CopyToOutputDirectory="PreserveNewest" Link="lng\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
