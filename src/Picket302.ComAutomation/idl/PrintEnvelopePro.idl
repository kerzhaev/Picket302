    // объявлений OLE Automation, из которой берутся идентификаторы
    // IUnknown и IDispatch.
    importlib("stdole2.tlb");

    // Прямое объявление типов библиотеки.
    interface IPEProApplication;

    [
        odl,
        uuid(3A98FA89-27EE-4DDF-8F5D-ABC47EA942E6),
