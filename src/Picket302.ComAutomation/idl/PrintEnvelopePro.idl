//
// Файл используется для сборки бинарной библиотеки типов PrintEnvelopePro.tlb
// компилятором MIDL (Windows SDK). Копия собранного файла поставляется в
// каталоге сборки COM-сервера и регистрируется в
// HKCU\Software\Classes\TypeLib\{22BC298D-DF0E-3C29-B589-7A50D3A8B871}\2.2.

[
    uuid(22BC298D-DF0E-3C29-B589-7A50D3A8B871),
