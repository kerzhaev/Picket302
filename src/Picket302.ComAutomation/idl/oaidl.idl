// Определения типов OLE Automation, используемые компилятором MIDL.
//
// MIDL подключает файл с именем oaidl.idl автоматически, когда в описании
// интерфейса встречаются типы OLE Automation (BSTR, VARIANT_BOOL, SAFEARRAY)
// или атрибут oleautomation. В Windows SDK этот файл содержит машинные
// директивы препроцессора, поэтому MIDL без C-препроцессора его не читает.
//
// Этот файл самодостаточен: базовые OLE-типы описаны в olebase.idl.
// Служебный проект сборки библиотеки типов (tools/typelib) проверяет
// результат: собранная библиотека типов должна содержать ровно 23 метода
// интерфейса IPEProApplication с DISPID 0x60020000…0x60020016.

import "olebase.idl";
