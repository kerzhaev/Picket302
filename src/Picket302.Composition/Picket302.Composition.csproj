<Project Sdk="Microsoft.NET.Sdk">

  <!-- Общий состав слоя данных: репозитории SQLite и прикладные службы,
       собираемые над одной сессией базы.

       Проект существует, чтобы одиночный режим и общий режим использовали
       ОДИН И ТОТ ЖЕ набор доменных правил: оболочка (Picket302.App) и
       серверная служба (Picket302.Service) берут состав отсюда, а не
       собирают каждый по-своему. -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Picket302.Composition</RootNamespace>
    <AssemblyName>Picket302.Composition</AssemblyName>
    <Description>Общий состав слоя данных Picket302: репозитории и прикладные службы над сессией базы.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picket302.Application\Picket302.Application.csproj" />
    <ProjectReference Include="..\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\Picket302.Infrastructure\Picket302.Infrastructure.csproj" />
    <ProjectReference Include="..\Picket302.Printing\Picket302.Printing.csproj" />
  </ItemGroup>

</Project>
