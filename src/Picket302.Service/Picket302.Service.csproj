<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Серверная служба совместного режима: фоновый процесс Windows, который
       обслуживает типизированный API общей базы.

       Служба — единственный владелец файла базы данных в общем режиме.
       Клиентские приложения обращаются к ней по сети; файл базы по SMB/UNC и
       прямой SQL-порт не используются.

       Хостинг: Kestrel из Microsoft.AspNetCore.App (общая платформа, без
       внешних пакетов), Windows-служба запускается через собственный
       диспетчер SCM (Microsoft.Extensions.Hosting.WindowsServices в офлайн-
       окружении недоступен). -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Picket302.Service</RootNamespace>
    <AssemblyName>Picket302.Service</AssemblyName>
    <Description>Серверная служба Picket302: общая база для совместной работы 1-5 рабочих мест.</Description>
    <UserSecretsId>picket302-shared-service</UserSecretsId>
    <!-- Служба работает без интерактивного окна и без окна консоли. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <!-- CA2007: предупреждение требует ConfigureAwait(false) и в форме
         «await using var x = …» меняет тип переменной на
         ConfiguredAsyncDisposable, из-за чего теряется доступ к членам
         освобождаемого ресурса. В службе освобождение ресурсов выполняется
         через await using, а ожидания внутри снабжены ConfigureAwait(false). -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picket302.Composition\Picket302.Composition.csproj" />
    <ProjectReference Include="..\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\Picket302.Infrastructure\Picket302.Infrastructure.csproj" />
    <ProjectReference Include="..\Picket302.Shared\Picket302.Shared.csproj" />
  </ItemGroup>

</Project>
