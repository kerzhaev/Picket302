<Project Sdk="Microsoft.NET.Sdk">

  <!-- Слой прикладных служб (ТЗ §2.1): сценарии рассылок, конвейеры импорта/экспорта,
       управление печатными сессиями, калькулятор тарифов, диспетчер COM-автоматизации.
       Допустимые зависимости: доменный слой и слой печати. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Picket302.Application</RootNamespace>
    <AssemblyName>Picket302.Application</AssemblyName>
    <Description>Слой прикладных служб Picket302: сценарии использования.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\Picket302.Printing\Picket302.Printing.csproj" />
  </ItemGroup>

  <!-- Словари топонимов и сокращений адреса (ТЗ §8.12, функция 148:
       «Словари топонимов и сокращений поставляются файлами, расширяемы»).
       Файлы включаются в сборку как встроенные ресурсы и копируются в
       каталог вывода, чтобы разбор адреса работал и в собранной
       программе, и в модульных тестах. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Toponyms\*.txt" />
    <None Update="Resources\Toponyms\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
