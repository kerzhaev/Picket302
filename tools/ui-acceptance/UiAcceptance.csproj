<Project Sdk="Microsoft.NET.Sdk">

  <!-- Acceptance-harness Picket302: управляемый показ реального MainShell
       на явном изолированном профиле. Не входит в Picket302.sln: собирается
       отдельно командой из docs/UX-REDESIGN-2026-11-05.md. Никогда не
       запускает COM, реестр и физическую печать; диалоги печати всегда
       закрываются оператором-драйвером без задания на принтер. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UiAcceptance</AssemblyName>
    <RootNamespace>Picket302.UiAcceptance</RootNamespace>
    <!-- PMv2 обязателен (stage3.1, DPI-симуляция): в SystemAware-процессе
         WmDpiChanged применяет только suggested-прямоугольник БЕЗ рескала
         контролов (DeviceDpi остаётся 96). Приложение собирается с тем же
         PerMonitorV2 (Picket302.App.csproj). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AppDllDir Condition="'$(AppDllDir)' == ''">$(MSBuildThisFileDirectory)..\..\src\Picket302.App\bin\x64\Release\net8.0-windows</AppDllDir>
  </PropertyGroup>

  <!-- Шрифт кодового штампа копируется рядом с драйвером: гард печати ищет
       его в каталоге программы (AppContext.BaseDirectory), и стенд печати
       иначе воспроизводит блокировку «Не найден шрифт ZIPcode.». -->
  <ItemGroup>
    <None Include="..\..\src\Picket302.App\Fonts\ZIPcode.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Picket302.App">
      <HintPath>$(AppDllDir)\Picket302.App.dll</HintPath>
    </Reference>
    <Reference Include="Picket302.Application">
      <HintPath>$(AppDllDir)\Picket302.Application.dll</HintPath>
    </Reference>
    <Reference Include="Picket302.Domain">
      <HintPath>$(AppDllDir)\Picket302.Domain.dll</HintPath>
    </Reference>
    <Reference Include="Picket302.Infrastructure">
      <HintPath>$(AppDllDir)\Picket302.Infrastructure.dll</HintPath>
    </Reference>
    <!-- Сценарий предпросмотра (2026-11-08): пиксельный скан страницы
         предпросмотра читает PreviewDocument из Printing.Preview. -->
    <Reference Include="Picket302.Printing">
      <HintPath>$(AppDllDir)\Picket302.Printing.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
