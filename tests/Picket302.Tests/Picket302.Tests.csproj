<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тестовый проект решения: unit-тесты доменных правил и инфраструктурного стека.
       ТЗ §11.1: юнит-тест — изолированная проверка доменных правил, без БД, принтера и UI;
       §11.2: БД-мок — SQLite in-memory. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Тесты обращаются к типам WinForms (MainShell) напрямую, поэтому проект
         подключает набор ссылок Windows Desktop. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Picket302.Tests</RootNamespace>
    <AssemblyName>Picket302.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Сборщик покрытия: измерение линий и ветвей (аудит UX, серия stage3
         2026-11-08). Подключается только как сборщик данных для прогона
         `dotnet test` с параметром collect "XPlat Code Coverage"; на обычный
         прогон тестов не влияет. -->
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Инфраструктурный стек для тестов слоя данных (§10.1, §11.2)">
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup Label="Тесты ссылаются на все проекты решения">
    <ProjectReference Include="..\..\src\Picket302.App\Picket302.App.csproj" />
    <ProjectReference Include="..\..\src\Picket302.Application\Picket302.Application.csproj" />
    <ProjectReference Include="..\..\src\Picket302.ComAutomation\Picket302.ComAutomation.csproj" />
    <ProjectReference Include="..\..\src\Picket302.Domain\Picket302.Domain.csproj" />
    <ProjectReference Include="..\..\src\Picket302.Infrastructure\Picket302.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Picket302.Printing\Picket302.Printing.csproj" />
    <!-- Контракт совместного режима: DTO, команды, коды ошибок и правила
         совместимости версий протокола. -->
    <ProjectReference Include="..\..\src\Picket302.Shared\Picket302.Shared.csproj" />
    <!-- Серверная служба совместного режима: проверки поднимают её
         в процессе теста на изолированном порту и в отдельном каталоге. -->
    <ProjectReference Include="..\..\src\Picket302.Service\Picket302.Service.csproj" />
  </ItemGroup>

  <ItemGroup Label="Платформа веб-приложения для проверок серверной службы">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Coverlet/Cecil не может переписать Picket302.App.dll без контекста компиляции:
       AssemblyResolutionException на System.Windows.Forms (параметры с WinForms-константами)
       молча исключало всю сборку App из coverage. Восстанавливает инструментирование App. -->
  <PropertyGroup>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
</Project>
