<Project>

  <!-- Централизованное управление версиями пакетов NuGet (Central Package Management).
       Все версии пакетов решения фиксируются только здесь. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Инфраструктура">
    <!-- Локальный/переносимый режим СУБД: SQLite 3 (§10.1, §10.2). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <!-- Доступ к данным репозиториев через микро-ORM (§10.1: EF Core + Dapper). -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <ItemGroup Label="Печать">
    <!-- Печать: GDI+/System.Drawing.Printing, System.Drawing.Common — только Windows (§10.1). -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.33" />
  </ItemGroup>

  <ItemGroup Label="Журналирование">
    <!-- Структурированный журнал с независимыми каналами и ротацией по размеру и дню
         (§10.3, §8.11, функция 111). -->
    <PackageVersion Include="Serilog" Version="3.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Label="Миграция с исходных баз">
    <!-- Импорт базы предшественника из MySQL (§8.9, функция 117): чисто управляемый драйвер. -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <!-- Импорт базы предшественника из Access .mdb через ODBC (§8.9, функция 118). -->
    <PackageVersion Include="System.Data.Odbc" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="Тесты">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
